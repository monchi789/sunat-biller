# ─────────────────────────────────────────────────────────────────────────────
# sunat-biller — plantilla de configuración
# Copia este archivo a `.env` y ajusta los valores. `.env` NO se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────────
# Entorno de DESPLIEGUE: development | production
# Es independiente de SUNAT_ENVIRONMENT: durante la homologación se opera con
# APP_ENV=production apuntando al SUNAT de pruebas.
# Con `production` NO se publican /docs, /redoc ni el esquema OpenAPI.
APP_ENV=development

DEBUG=false
API_PORT=7890
API_V1_PREFIX=/api/v1

# Clave para firmas internas / usos generales. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Autoriza el aprovisionamiento (crear empresas y emitir sus API keys), enviado
# como cabecera X-Admin-Token. Hace falta porque toda API key pertenece a una
# empresa, así que la primera empresa no puede crearse con una.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Clave Fernet para cifrar secretos en reposo (contraseñas SOL y de certificados).
# OBLIGATORIA en producción. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotarla invalida todos los secretos ya cifrados: reingresa credenciales tras rotar.
ENCRYPTION_KEY=

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sunat_biller
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sunat_biller_test

# ── Redis (cola del worker) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Almacenamiento ───────────────────────────────────────────────────────────
# XML firmados, CDR y PDF. En compose es un volumen persistente.
STORAGE_ROOT=./data/storage
# Certificados PFX/P12. Fuera del árbol público de storage.
CERTIFICATE_ROOT=./data/certificates
MAX_CERTIFICATE_SIZE_MB=5

# ── SUNAT ────────────────────────────────────────────────────────────────────
# A qué billService se envía. Distinto de APP_ENV.
# En BETA el usuario SOL es {TU_RUC}MODDATOS con clave `moddatos`, y no hace
# falta un certificado registrado en SUNAT.
# BETA (homologación) | PRODUCTION
SUNAT_ENVIRONMENT=BETA
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PRODUCTION_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
SUNAT_TIMEOUT_SECONDS=30

# ── Reglas tributarias (parámetros normativos, cambian por norma) ────────────
IGV_RATE=0.18
ICBPER_RATE=0.50
# Umbral sobre el que la boleta exige identificar al cliente (S/)
RECEIPT_CUSTOMER_THRESHOLD=700.00
# Días hacia atrás permitidos para emisión extemporánea
MAX_ISSUE_BACKDATE_DAYS=3

# ── Idempotencia ─────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_HOURS=24

# ── Webhooks salientes ───────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=6

# ── CORS (lista separada por comas; vacío = ninguno) ─────────────────────────
CORS_ORIGINS=
